{
  "name": "spc-converter",
  "description": "🎮🎶 Node.js library and command line program to convert Super Nintendo SPC files to WAV or PCM audio.",
  "author": "Eric Newport <kethinov@gmail.com>",
  "contributors": [
    {
      "name": "Contributors",
      "url": "https://github.com/kethinov/spc-converter/graphs/contributors"
    }
  ],
  "version": "2.0.0",
  "files": [
    "spc-converter.js",
    "loadSpcPlayer.js",
    "spc-emulator.js",
    "didYouMean.js"
  ],
  "homepage": "https://github.com/kethinov/spc-converter.git",
  "license": "LGPL-2.1-only",
  "main": "loadSpcPlayer.js",
  "bin": {
    "spc-converter": "spc-converter.js"
  },
  "readmeFilename": "README.md",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "spc-tag": "1.1.0"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "standard": "17.1.2"
  },
  "scripts": {
    "build": "node build-wasm.js",
    "prepack": "node build-wasm.js",
    "pretest": "node build-wasm.js --if-missing",
    "precoverage": "node build-wasm.js --if-missing",
    "coverage": "c8 --reporter=text --reporter=lcov --exclude=test.js --exclude=spc-emulator.js node --test test.js",
    "lint": "standard",
    "lint-fix": "standard --fix",
    "test": "node --test test.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/kethinov/spc-converter.git"
  },
  "keywords": [
    "snes",
    "SNES",
    "super nintendo",
    "Super Nintendo",
    "spc",
    "SPC",
    "converter",
    "SPC700",
    "SNES-SPC700"
  ],
  "funding": "https://www.paypal.com/paypalme/newport",
  "standard": {
    "ignore": [
      "spc-emulator.js",
      "vendor/"
    ]
  }
}
